---
import { useTranslations } from "../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const links = [
  {
    key: "services",
    href: "#services",
  },
  {
    key: "results",
    href: "#results",
  },

  // {
  //   key: "infrastructure",
  //   href: "#infrastructure",
  // },
  {
    key: "pricing",
    href: "#pricing",
  },

  {
    key: "howItWorks",
    href: "#howitworks",
  },
  {
    key: "contact",
    href: "#contact",
  },
  // {
  //   key: "faq",
  //   href: "#faq",
  // },
];
---

<header
  class="flex items-center justify-between h-20 font-DM fixed top-0 w-screen z-10 px-8 transition"
>
  <a href="#" class="w-32 font-manrope font-bold" data-aos="fade-right"
    >INVERCON</a
  >
  <nav class="grow hidden lg:block">
    <ul class="flex items-center justify-center gap-12">
      {
        links.map((l, i) => (
          <li>
            <a
              data-aos="zoom-in"
              data-aos-delay={100 * i}
              href={`#${l.key.toLowerCase().replaceAll(" ", "")}`}
              class="border-b border-transparent hover:border-white transition"
            >
              {t.header.links[l.key]}
            </a>
          </li>
        ))
      }

      <li>
        <a
          data-aos="zoom-in"
          data-aos-delay={500}
          href={`${locale == "en" ? "/es" : "/"}`}
          class="border-b border-transparent hover:border-white transition"
        >
          {locale == "en" ? "Español" : "English"}
        </a>
      </li>
    </ul>
  </nav>
  <button
    data-aos="fade-left"
    class="bg-indigo-500 text-white py-2 rounded-full font-medium w-32"
  >
    {t.header.buttons.bookCall}
  </button>
</header>

<style>
  header {
    color: white;
    transition: background 0.323s ease-in-out;
  }

  header.active {
    color: oklch(58.5% 0.233 277.117);
    background-color: white;
  }

  header.active li:hover a {
    border-color: oklch(58.5% 0.233 277.117);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector("header");
    let scroll = window.scrollY;

    document.addEventListener("scroll", () => {
      scroll = window.scrollY;

      if (scroll >= 690) {
        header?.classList.add("active");
      } else {
        header?.classList.remove("active");
      }
    });
  });
</script>
