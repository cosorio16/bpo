---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const targets = [
  { key: "logistics", icon: null },
  { key: "saas", icon: null },
  { key: "healthcare", icon: null },
  { key: "retail", icon: null },
  { key: "fintech", icon: null },
  { key: "professionalServices", icon: null },
];
---

<section
  id="industries"
  class="py-20 lg:py-40 px-8 max-w-7xl m-auto font-manrope flex flex-col lg:gap-20 gap-12"
>
  <h1 class="text-4xl lg:text-7xl" data-aos="fade-up">
    {t.target.title.line1}
    <span class="text-indigo-500 font-medium"> {t.target.title.highlight}</span>
    <br />
    {t.target.title.line2}
  </h1>

  <div class="font-DM flex flex-col gap-4">
    {
      targets.map((target, i) => (
        <div
          data-aos="zoom-in"
          data-aos-delay={100 * i}
          class="lg:py-8 py-4 lg:px-12 px-6 text-lg lg:text-4xl bg-indigo-50 text-indigo-500 font-medium w-fit rounded-full"
        >
          <p>{t.target.items[target.key]}</p>
        </div>
      ))
    }
  </div>
</section>
