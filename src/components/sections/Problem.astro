---
import { useTranslations } from "../../i18n/utils";
import CreditCardIcon from "../../icons/CreditCardIcon.astro";
import UsersLimited from "../../icons/UsersLimited.astro";
import DelayIcon from "../../icons/DelayIcon.astro";
import PuzzleIcon from "../../icons/PuzzleIcon.astro";
import UsersRaysIcon from "../../icons/UsersRaysIcon.astro";

const items = [
  {
    key: "risingCosts",
    icon: CreditCardIcon,
  },
  {
    key: "",
    icon: null,
  },
  {
    key: "",
    icon: null,
  },
  {
    key: "scalableTeams",
    icon: UsersLimited,
  },
  {
    key: "timezoneDelays",
    icon: DelayIcon,
  },
  {
    key: "",
    icon: null,
  },
  {
    key: "",
    icon: null,
  },
  {
    key: "departmentIntegration",
    icon: PuzzleIcon,
  },
  {
    key: "employeeTurnover",
    icon: UsersRaysIcon,
  },
];

const locale = Astro.currentLocale;
const t = await useTranslations(locale);
---

<section
  class="px-2 py-40 lg:px-8 flex flex-col gap-5 items-center text-center font-DM"
>
  <div class="flex flex-col gap-2">
    <h1 class="text-5xl lg:text-6xl" data-aos="fade-up">
      {t.problem.title.line1}
      <span class="text-indigo-500 font-semibold"
        >{t.problem.title.highlight}</span
      >
      <br />
      {t.problem.title.line2}
    </h1>

    <h2
      class="text-xl lg:text-2xl text-neutral-600"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      {t.problem.subtitle}
    </h2>
  </div>

  <div class="hidden lg:grid grid-cols-2 gap-6 w-full px-4">
    {
      items.map(({ key, icon: Icon }, i) => (
        <div
          data-aos={i % 2 == 0 ? "fade-left" : "fade-right"}
          class={`h-32 w-full text-3xl 2xl:text-4xl flex items-center justify-center gap-3`}
        >
          {Icon && (
            <span class="text-indigo-500">
              <Icon sizes="45" />
            </span>
          )}
          {key && <h1 class="whitespace-nowrap">{t.problem.items[key]}</h1>}
        </div>
      ))
    }
  </div>

  <div class="lg:hidden flex flex-col gap-3">
    {
      items.map((item, i) => (
        <div
          data-aos="fade-up"
          data-delay={`${100 * i}`}
          class={`${item.key == "" ? "hidden" : "text-start bg-indigo-50 text-indigo-500 rounded-full py-2 px-4"}`}
        >
          <p>{t.problem.items[item.key]}</p>
        </div>
      ))
    }
  </div>

  <p 
  data-aos="fade-up"
  class="text-xl text-indigo-500">
    {t.problem.footer}
  </p>
</section>
