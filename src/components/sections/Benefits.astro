---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const benefits = [
  "realCostReduction",
  "timeZoneAlignment",
  "bilingualTalent",
  "operationalEfficiency",
  "scalabilityOnDemand",
  "fullVisibility",
];
---

<section
  class="py-20 lg:py-40 px-4 lg:px-8 font-DM flex flex-col gap-16 max-w-7xl m-auto"
>
  <h1
    class="font-manrope text-2xl lg:text-6xl text-center font-medium"
    data-aos="fade-up"
  >
    {t.benefits.title.line1}
    <span> {t.benefits.title.highlight1}</span>
    {t.benefits.title.line2}
    <span>{t.benefits.title.highlight2} </span>
  </h1>

  <div class="hidden lg:grid grid-cols-2 gap-6">
    {
      benefits.map((b, i) => {
        const indexCards = [1, 2, 5];

        return (
          <div
            data-aos="zoom-in"
            class={`flex flex-col items-center justify-center text-center p-4 ${indexCards.includes(i) ? "bg-indigo-500 text-white" : "shadow border border-neutral-100"} h-52 rounded`}
          >
            <h1 class="text-3xl">{t.benefits.items[b].title}</h1>
            <p class="text-lg">{t.benefits.items[b].description}</p>
          </div>
        );
      })
    }
  </div>

  <div class="lg:hidden grid grid-cols-1 gap-6">
    {
      benefits.map((b, i) => (
        <div
          data-aos="zoom-in"
          class={`flex flex-col items-center justify-center text-center p-4 ${i % 2 == 0 ? "bg-indigo-500 text-white" : "shadow border border-neutral-100"} h-52 rounded`}
        >
          <h1 class="text-3xl">{t.benefits.items[b].title}</h1>
          <p class="text-lg">{t.benefits.items[b].description}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  span {
    color: oklch(58.5% 0.233 277.117);
    font-weight: 700;
    text-decoration: underline wavy;
    /* font-family: "DM", sans-serif; */
  }
</style>
