---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const steps = ["discovery", "customStrategy", "pilotLaunch", "scaleOperations"];
---

<section
  id="howitworks"
  class="px-8 py-12 lg:py-40 max-w-7xl m-auto font-manrope flex flex-col gap-16"
>
  <h1 class="text-7xl lg:text-8xl font-medium" data-aos="fade-up">
    {t.howItWorks.title.line1}
    <br />{t.howItWorks.title.line2}
    <br />{t.howItWorks.title.line3}
  </h1>

  <div class="flex flex-col gap-32">
    {
      steps.map((step) => (
        <div class="flex items-start lg:gap-12 gap-6 relative ">
          <div
            data-aos="fade-right"
            class="size-16 lg:size-20 aspect-square bg-indigo-500 text-white flex items-center justify-center rounded-full text-xl lg:text-5xl"
          >
            {t.howItWorks.steps[step].step}
          </div>
          <div>
            <h2 class="font-DM text-2xl lg:text-4xl text-indigo-500" data-aos="fade-up">
              {t.howItWorks.steps[step].title}
            </h2>
            <p
              data-aos="fade-up"
              data-aos-delay="100"
              class="text-lg lg:text-2xl font-medium text-neutral-600"
            >
              {t.howItWorks.steps[step].description}
            </p>
          </div>

          {t.howItWorks.steps[step].step < steps.length && (
            <span
              data-aos="zoom-in"
              class="border absolute h-full lg:top-[130%] top-[75%] left-10 border-neutral-300"
            />
          )}
        </div>
      ))
    }
  </div>
</section>
