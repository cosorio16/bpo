---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);
---

<section class="lg:px-8 px-4 lg:py-40 py-20 max-w-7xl m-auto font-manrope flex flex-col gap-8">
  <h1 class="text-3xl lg:text-5xl text-center font-semibold" data-aos="fade-up">
    {t.differentiation.title.line1}
    <br />
    <span class="text-indigo-500 font-DM font-medium">
      {t.differentiation.title.highlight}
    </span>
  </h1>

  <div class="grid grid-cols-1 lg:grid-cols-2">
    <div
      class="border border-r-0 border-neutral-200 py-12 px-8 min-h-96 justify-center flex flex-col gap-4"
    >
      <h2
        class="text-4xl font-DM font-semibold text-neutral-500"
        data-aos="fade-up"
      >
        {t.differentiation.traditionalBpo.title}
      </h2>
      <ul class="text-lg lg:text-2xl text-neutral-400">
        <li data-aos="zoom-in" class="py-2 border-b-4 border-black/10">
          {t.differentiation.traditionalBpo.items.taskExecution}
        </li>
        <li data-aos="zoom-in" class="py-2 border-b-4 border-black/10">
          {t.differentiation.traditionalBpo.items.limitedVisibility}
        </li>
        <li data-aos="zoom-in" class="py-2 border-b-4 border-black/10">
          {t.differentiation.traditionalBpo.items.reactiveSupport}
        </li>
      </ul>
    </div>

    <div
      class="pt-20 border border-neutral-200 py-12 px-8 min-h-96 justify-center flex flex-col gap-4 bg-indigo-500 text-white relative"
    >
      <div class="flex flex-col gap-2">
        <div
          data-aos="zoom-in"
          class="flex items-center gap-3 px-4 py-1 bg-white text-indigo-500 font-medium rounded-full w-fit absolute top-4 right-4"
        >
          {t.differentiation.invercon.badge}

          <div class="size-3 bg-indigo-600 rounded-full relative">
            <div
              class="size-3 bg-indigo-600 rounded-full absolute animate-ping"
            >
            </div>
          </div>
        </div>
        <h2 class="text-4xl font-DM font-semibold" data-aos="fade-up">
          {t.differentiation.invercon.title}
        </h2>
      </div>

      <ul class="text-lg lg:text-2xl">
        <li data-aos="zoom-in" class="py-2 border-b-4 border-white/10">
          {t.differentiation.invercon.items.dataDriven}
        </li>
        <li data-aos="zoom-in" class="py-2 border-b-4 border-white/10">
          {t.differentiation.invercon.items.performanceImprovement}
        </li>
        <li data-aos="zoom-in" class="py-2 border-b-4 border-white/10">
          {t.differentiation.invercon.items.integratedSystems}
        </li>
      </ul>
    </div>
  </div>
</section>
