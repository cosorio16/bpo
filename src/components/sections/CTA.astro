---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);
---

<section
  class="px-8
   bg-indigo-500 text-white font-manrope flex flex-col items-center border-b border-white/20"
>
  <div class="max-w-7xl w-full py-12 flex flex-col gap-4">
    <h1 class="text-4xl lg:text-8xl font-DM" data-aos="fade-up">
      {t.cta.title}
    </h1>

    <h2 class="text-xl lg:text-3xl font-medium" data-aos="fade-up" data-aos-delay="100">
      {t.cta.subtitle}
    </h2>

    <div class="flex flex-col lg:grid grid-cols-2 items-center gap-8">
      <a href="#pricing" class="ring-2 px-4 py-2.5 text-lg w-full text-center" data-aos="zoom-in" data-aos-delay="200">
        {t.cta.buttons.analysis}
      </a>
      <a href="#contact" class="ring-2 px-4 py-2.5 text-lg w-full text-center" data-aos="zoom-in" data-aos-delay="300">
        {t.cta.buttons.strategyCall}
      </a>
    </div>
  </div>
</section>
