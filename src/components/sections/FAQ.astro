---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);
const questions = [
  "nearshoreBpo",
  "startTime",
  "quality",
  "scalability",
  "difference",
];
---

<section
  id="faq"
  class="px-8 py-20 lg:py-40 max-w-7xl m-auto font-DM flex flex-col gap-16"
>
  <h1 class="text-center text-6xl lg:text-7xl text-indigo-500" data-aos="fade-up">
    {t.faq.title}
  </h1>

  <div class="flex flex-col gap-12">
    {
      questions.map((q) => (
        <div
          data-aos="fade-up"
          class="flex flex-col gap-2 pb-4 border-b border-neutral-200"
        >
          <h1 class="py-2 text-2xl lg:text-4xl text-neutral-800 font-manrope font-medium">
            {t.faq.questions[q].question}
          </h1>
          <p class="text-lg lg:text-2xl text-neutral-600"> {t.faq.questions[q].answer}</p>
        </div>
      ))
    }
  </div>
</section>
