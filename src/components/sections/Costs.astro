---
import Calc from "../react/Calc.jsx";
import { useTranslations } from "../../i18n/utils";

const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const keys = [
  t.costs.keys.laborCosts,
  t.costs.keys.infrastructureExpenses,
  t.costs.keys.turnoverCosts,
  t.costs.keys.roiIncrease,
];
---

<section
  id="pricing"
  class="px-2 lg:px-8 py-20 lg:py-40 grid grid-cols-1 lg:grid-cols-2 max-w-7xl m-auto font-DM gap-12"
>
  <div
    class="flex items-center justify-start grow lg:order-1 order-2 p-1"
    data-aos="fade-down"
  >
    <Calc t={t} client:load />
  </div>

  <div
    class="flex flex-col gap-8 p-8 border border-neutral-200 lg:order-2 order-1"
    data-aos="fade-up"
  >
    <div class="flex flex-col gap-2">
      <h1 class="text-5xl">
        {t.costs.title.line1}
        <br />
        <span class="text-indigo-500">
          {t.costs.title.highlight}
        </span>
      </h1>

      <h2 class="text-2xl text-neutral-500">
        {t.costs.subtitle}
      </h2>

      <ul class="flex items-center flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          keys.map((k, i) => (
            <li class="px-4 py-2 text-indigo-500 bg-indigo-50 rounded-full border border-indigo-200">
              {k}
            </li>
          ))
        }
      </ul>
    </div>

    <button
      class="ring-2 ring-indigo-500 px-4 py-2 text-indigo-500 text-2xl lg:text-4xl font-manrope font-medium"
    >
      {t.costs.button}
    </button>
  </div>
</section>