---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const items = [
  {
    key: "healthcare",
    items: ["payrollReduction", "billingDecrease"],
  },
  {
    key: "saas",
    items: ["costSavings", "leadIncrease"],
  },
  {
    key: "legal",
    items: ["costReduction", "backlogEliminated"],
  },
  {
    key: "ecommerce",
    items: ["adminSavings", "financialCycles"],
  },
];
---

<section class="px-8 py-20 lg:py-40 max-w-7xl m-auto font-DM flex flex-col gap-8">
  <h1 class="text-2xl lg:text-6xl text-center font-medium" data-aos="fade-up">
    {t.results.title.line1}
    <span class="font-manrope text-indigo-500 font-semibold results">
      {t.results.title.highlight}
    </span>
    {t.results.title.line2}
  </h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 gridContainer">
    {
      items.map((item) => (
        <div
          data-aos="zoom-out"
          class="border px-4 py-8 border-neutral-200 rounded flex flex-col gap-3"
        >
          <h2 class="text-indigo-500 lg:text-5xl text-2xl">
            {t.results.items[item.key].title}
          </h2>

          <div class="flex flex-col gap-1">
            {item.items.map((sub) => (
              <p class="text-lg lg:text-2xl">{t.results.items[item.key].results[sub]}</p>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
