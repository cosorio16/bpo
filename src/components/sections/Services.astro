---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const services = [
  {
    title: "logisticsTransportation",
    items: [
      "routeOptimization",
      "fleetManagement",
      "coldChain",
      "warehouseOperations",
      "importExport",
    ],
  },
  {
    title: "customerExperience",
    items: [
      "multichannelSupport",
      "bilingualService",
      "slaPerformance",
      "qaCoaching",
    ],
  },
  {
    title: "backOffice",
    items: ["accounts", "payroll", "dataEntry", "financialWorkflows"],
  },
  {
    title: "technicalSupport",
    items: [
      "helpDesk",
      "infrastructureMonitoring",
      "systemSupport",
      "continuityManagement",
    ],
  },
  {
    title: "salesLeadGeneration",
    items: [
      "leadQualification",
      "crmManagement",
      "outboundInbound",
      "pipelineAcceleration",
    ],
  },
];
---

<section id="services" class="lg:px-8 px-2 py-20 lg:py-40 bg-indigo-500 text-white font-DM">
  <div class="max-w-7xl m-auto flex flex-col gap-16">
    <div class="text-center flex flex-col gap-3">
      <h1 class="text-4xl lg:text-8xl font-bold" data-aos="fade-up">
        {t.services.title}
      </h1>
      <h2 class="lg:text-3xl text-lg font-medium" data-aos="fade-up" data-aos-delay="100">
        {t.services.subtitle}
      </h2>
    </div>

    <div class="flex flex-col gap-16">
      {
        services.map((key, i) => (
          <div class="flex flex-col gap-4">
            <h1
              class="text-2xl lg:text-5xl font-medium border-b-2 py-4 px-2 border-white/20"
              data-aos="fade-up"
            >
              {t.services.items[key.title].title}
            </h1>

            <ul class="flex flex-col flex-wrap gap-4 lg:gap-8 text-sm lg:text-2xl px-4 font-manrope">
              {key.items.map((item) => (
                <li
                  data-aos="zoom-in"
                  class="px-4 py-2 bg-white/10 rounded-lg w-fit"
                >
                  {t.services.items[key.title].items[item]}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
