---
import { useTranslations } from "../../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);
const features = [
  { key: "soc2", icon: null },
  { key: "secureData", icon: null },
  { key: "redundantConnectivity", icon: null },
  { key: "cloudTools", icon: null },
  { key: "realTimeReporting", icon: null },
];
---

<section
  id="infrastructure"
  class="lg:py-40 py-20 lg:px-8 px-4 max-w-7xl m-auto flex flex-col gap-20 font-manrope"
>
  <h1 class="text-4xl lg:text-7xl text-end" data-aos="fade-up">
    {t.infrastructure.title.line1}
    <br />
    <span class="text-indigo-500 font-medium">
      {t.infrastructure.title.highlight1}
    </span>
    {t.infrastructure.title.line2}
    <span class="text-indigo-500 font-medium">
      {t.infrastructure.title.highlight2}</span
    >
  </h1>

  <div class="font-DM flex items-end flex-col gap-4">
    {
      features.map((f, i) => (
        <div
          data-aos="zoom-in"
          data-aos-delay={100 * i}
          class="lg:py-8 py-6 px-8 lg:px-12 text-lg lg:text-4xl bg-indigo-50 text-indigo-500 font-medium w-fit rounded-full text-end"
        >
          <p>{t.infrastructure.features[f.key]}</p>
        </div>
      ))
    }
  </div>
</section>
