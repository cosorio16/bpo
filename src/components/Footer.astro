---
import { useTranslations } from "../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

const sections = [
  {
    key: "company",
    links: ["about", "careers", "contact"],
  },
  {
    key: "services",
    links: [
      "technicalSupport",
      "logistics",
      "backOffice",
      "customerExperience",
    ],
  },
  {
    key: "resources",
    links: ["caseStudies", "blog", "faq"],
  },
  {
    key: "legal",
    links: ["privacyPolicy", "termsOfService"],
  },
];
---

<footer
  class="bg-indigo-500 text-white flex items-center justify-center font-DM px-8"
>
  <div class="max-w-7xl w-full pt-20 flex flex-col gap-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {
        sections.map((s) => (
          <div data-aos="fade-down" class="flex flex-col gap-4">
            <h1 class="text-white/75 font-bold">{t.footer.sections[s.key].title}</h1>

            {s.links.map((l) => (
              <a href="#" class="border-b border-white/30 pb-1.5">{t.footer.sections[s.key].links[l]}</a>
            ))}
          </div>
        ))
      }
    </div>

    <div class="py-4 flex flex-col items-center text-white/70 text-center">
      <p>{t.footer.bottom.copyright}</p>
      <p>{t.footer.bottom.description}</p>
    </div>
  </div>
</footer>
