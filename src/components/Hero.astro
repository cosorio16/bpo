---
import { useTranslations } from "../i18n/utils";
const locale = Astro.currentLocale;
const t = await useTranslations(locale);

import PhoneIcon from "../icons/PhoneIcon.astro";
import ChartIcon from "../icons/ChartIcon.astro";
---

<div class="w-full relative font-manrope h-dvh max-h-210">
  <div
    id="home"
    class="flex flex-col items-center justify-center max-w-7xl m-auto text-center gap-8 text-white py-60"
  >
    <!-- <div
      class="absolute inset-0 -z-10 h-full w-full items-center px-5 py-24 [background:radial-gradient(125%_125%_at_50%_10%,#000_40%,#63e_100%)]"
    >
    </div> -->

    <div
      class="bg-[url(https://images.openai.com/static-rsc-4/oNuiW7QkNpgZEQUZfOm0WA_gMwAualsSgic6x4wDquzCupt3qmXnVxkcqOB6nuXrgfqUEOLJZQajjqVF-_kvpqw719GIWNN32xoWZqzAN6UiRnlV2NVOqCpavqJyQpQonZqwsL6vPYMahLmNStxShP5z4JXAtBCnou42xd-1PCN0-uhhHPgen8je8fbKV7by?purpose=fullsize)] absolute inset-0 bg-no-repeat bg-cover bg-center"
    >
      <div
        class="absolute inset-0 bg-linear-to-b from-black/90 to-indigo-500/50"
      >
      </div>
    </div>

    <div class="flex flex-col items-center gap-3 w-full p-1">
      <h1
        class="text-2xl lg:text-6xl font-medium font-manrope"
        data-aos="fade-up"
      >
        {t.hero.title.line1}
        <br />
        <span class="text-indigo-500 font-semibold font-DM">
          {t.hero.title.highlight}</span
        >
      </h1>

      <h2 class="lg:text-lg lg:w-1/2" data-aos="fade-up" data-aos-delay="100">
        {t.hero.subtitle}
      </h2>
    </div>

    <!-- <p>
      We are not a call center. We are an operational engineering partner that
      transforms logistics, customer experience, and back-office processes into
      scalable, high-performance systems.
    </p> -->

    <div class="flex flex-col lg:flex-row items-center gap-8 text-xl">
      <a
        href="#contact"
        data-aos="fade-down"
        class="ring-2 flex items-center gap-3 ring-indigo-500 px-8 py-3 rounded-full bg-indigo-500 text-white w-full lg:w-fit"
      >
        <PhoneIcon sizes="30" />
        {t.hero.buttons.strategyCall}
      </a>
      <a
        href="#pricing"
        data-aos="fade-down"
        class="ring-2 flex items-center gap-3 px-8 py-3 rounded-full text-white w-full lg:w-fit"
      >
        <ChartIcon sizes="30" />
        {t.hero.buttons.analysis}</a
      >
    </div>
  </div>
</div>

